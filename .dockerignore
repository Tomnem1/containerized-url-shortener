# Secrets: must never end up in an image
.env
.env.*

# Local Python environment and caches 
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Git 
.git/
.gitignore

# Tests and dev tooling: they run in CI, not in the production image
tests/
pytest.ini
requirements-dev.txt

# Docs and personal notes
*.md
LICENSE
